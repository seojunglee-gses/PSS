# Public JavaScript app key. Register each actual production/preview/local origin in Kakao.
NEXT_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key
# Server-only REST API key. Never add NEXT_PUBLIC_ to this variable.
KAKAO_REST_API_KEY=your_kakao_rest_api_key
# Keep existing Firebase/AI variables in the deployment; this file does not replace them.
