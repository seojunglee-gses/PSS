rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function projectManager(projectId) {
      return signedIn() && request.auth.token.get('email', '') != '' && (
        request.auth.token.get('email', '').lower() == 'adm@snu.ac.kr' ||
        (exists(/databases/$(database)/documents/ppssProjects/$(projectId)) &&
         get(/databases/$(database)/documents/ppssProjects/$(projectId)).data.get('projectAdmin', '').replace('^ +| +$', '').lower() == request.auth.token.get('email', '').lower())
      );
    }
    function projectMember(projectId) {
      return signedIn() && exists(/databases/$(database)/documents/ppssProjects/$(projectId)) && (
        projectManager(projectId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId)).data.role == 'participant' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)/projectMemberships/$(projectId)).data.get('revoked', false) != true)
      );
    }
    function scoped(collectionId) {
      return collectionId.matches('^(users|ppssChatLogs|ppssWorkspaceSummaries|ppssEvaluations|ppssStageLocks|ppssBackgroundKnowledge|ppssBackgroundKnowledgeArchives|ppssSiteImages|ppssGeneratedImages|ppssUserDesignSubmissions|ppssEvaluationImages|ppssExecutiveSummaries)_.*');
    }
    // Project codes/administrator metadata are accessed only through the trusted API.
    match /ppssProjects/{projectId} { allow read, write: if false; }
    // Client reads are private; Admin SDK alone writes authorization and navigation state.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
      match /projectMemberships/{projectId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /{collectionId}/{documentId}/{nested=**} {
      allow read: if scoped(collectionId) && projectMember(collectionId.replace('^[^_]+_', '')) &&
        (!collectionId.matches('^(users|ppssChatLogs)_.*') || request.auth.uid == documentId);
      allow write: if scoped(collectionId) && projectMember(collectionId.replace('^[^_]+_', '')) &&
        (!collectionId.matches('^(users|ppssChatLogs|ppssWorkspaceSummaries)_.*') || request.auth.uid == documentId) &&
        (!collectionId.matches('^(ppssStageLocks|ppssBackgroundKnowledge|ppssBackgroundKnowledgeArchives|ppssSiteImages|ppssExecutiveSummaries)_.*') || projectManager(collectionId.replace('^[^_]+_', '')));
    }
    // Existing unscoped resources retain their original rules.
    match /ppssBackgroundKnowledge/{documentId} { allow read: if true; allow write: if isAdmin(); }
    match /ppssBackgroundKnowledgeArchives/{documentId} { allow read: if true; allow write: if isAdmin(); }
    match /ppssSiteImages/{documentId} { allow read: if true; allow write: if isAdmin(); }
    match /ppssGeneratedImages/{documentId} { allow read: if true; allow write: if signedIn(); }
    match /ppssUserDesignSubmissions/{documentId} { allow read, write: if signedIn(); }
    // Exclude protected paths: a permissive wildcard would override the restrictions above.
    match /{collectionId}/{document=**} {
      allow read, write: if signedIn() && collectionId != 'users' && collectionId != 'ppssProjects' && !scoped(collectionId);
    }
  }
}
